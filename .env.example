# Campaign Pulse environment (copy to .env). No secrets or paid services are required.

# Backend ---------------------------------------------------------------
# SQLite for local development (relative paths resolve against backend/). For hosting, use a Postgres URL such as postgresql://user:pass@host/db?sslmode=require (see docs/DEPLOYMENT.md).
DATABASE_URL=sqlite:///./data/campaign_pulse.db
# Comma-separated list of origins allowed to call the API (the frontend URL).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Only "simulation" is implemented. No real email is ever sent.
EMAIL_PROVIDER=simulation
MAX_UPLOAD_BYTES=5242880
MAX_IMPORT_ROWS=20000
# Optional: when set, every POST/PATCH/DELETE must send a matching X-API-Key header.
API_KEY=
UNSUBSCRIBE_BASE_URL=https://example.com/unsubscribe

# Frontend (also written to frontend/.env.local by scripts/setup.sh) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
